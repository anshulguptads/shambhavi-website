---
/**
 * InsightTest signature scene — self-healing automation, live.
 *
 * A test run advances → the selector breaks (red) → the healer scans the DOM
 * with visual/semantic/positional signals → the selector rewrites itself
 * (green) → the run continues and the pass counter keeps climbing.
 * Server renders the HEALED final state (that's the no-JS/static view);
 * the enhancement rewinds and plays the story on scroll.
 */
---

<div class="selfheal-scene max-w-5xl mx-auto mb-14 md:mb-16" role="img" aria-label="A test whose selector broke is healed automatically: the healer matches the new element by visual, semantic, and positional signals, rewrites the selector, and the run continues without an engineer.">
  <div class="rounded-3xl bg-navy-deepest border border-cream/10 overflow-hidden shadow-lift">

    {/* Window chrome */}
    <div class="flex items-center justify-between px-5 py-3 border-b border-cream/10 bg-navy-deep/40">
      <div class="flex items-center gap-3">
        <span class="flex gap-1.5" aria-hidden="true">
          <span class="w-2.5 h-2.5 rounded-full bg-cream/15"></span>
          <span class="w-2.5 h-2.5 rounded-full bg-cream/15"></span>
          <span class="w-2.5 h-2.5 rounded-full bg-cream/15"></span>
        </span>
        <span class="font-mono text-[11px] text-onDark-muted">checkout.spec.ts · run #4182</span>
      </div>
      <div class="font-mono text-[11px] text-onDark-muted">
        <span class="sh-pass text-saffron-300 tabular-nums">252</span><span class="text-onDark-faint">/312 passed</span>
      </div>
    </div>

    <div class="grid md:grid-cols-[1.15fr_0.85fr]">
      {/* Code panel */}
      <div class="p-5 md:p-6 font-mono text-[11px] md:text-xs leading-[1.9] text-onDark-secondary relative">
        <div class="sh-line" data-l="1"><span class="text-onDark-faint mr-3">14</span>await page.fill(<span class="text-saffron-200">'#qty'</span>, <span class="text-saffron-200">'2'</span>);</div>
        <div class="sh-line" data-l="2"><span class="text-onDark-faint mr-3">15</span>await page.selectOption(<span class="text-saffron-200">'#size'</span>, <span class="text-saffron-200">'M'</span>);</div>
        <div class="sh-line relative" data-l="3">
          <span class="text-onDark-faint mr-3">16</span>await page.click(<span class="sh-sel-wrap relative inline-block">
            <span class="sh-sel-old absolute left-0 top-0 text-[#e58aa5] line-through opacity-0" aria-hidden="true">'.btn-submit'</span>
            <span class="sh-sel-new text-[#9fdcb4]">'[data-testid="submit-order"]'</span>
          </span>);
          <span class="sh-healed-tag ml-2 text-[9px] uppercase tracking-wider px-1.5 py-0.5 rounded bg-[#9fdcb4]/10 text-[#9fdcb4] border border-[#9fdcb4]/30">healed · 0.93</span>
        </div>
        <div class="sh-line" data-l="4"><span class="text-onDark-faint mr-3">17</span>await expect(page.locator(<span class="text-saffron-200">'.order-confirm'</span>)).toBeVisible();</div>

        {/* run cursor */}
        <div class="sh-cursor absolute left-0 right-0 h-[1.9em] bg-saffron-400/[0.07] border-l-2 border-saffron-400/70 pointer-events-none" style="top: 1.25rem;" aria-hidden="true"></div>
      </div>

      {/* Log + healer panel */}
      <div class="border-t md:border-t-0 md:border-l border-cream/10 p-5 md:p-6 flex flex-col gap-2 font-mono text-[10px] md:text-[11px] leading-relaxed">
        <div class="text-[9px] uppercase tracking-wider text-onDark-muted mb-1">run log</div>
        <div class="sh-log-ok text-onDark-secondary">✓ 16:41:02 add-to-cart · 1.2s</div>
        <div class="sh-log-fail text-[#e58aa5]">✗ 16:41:04 '.btn-submit' not found <span class="text-onDark-faint">(DOM changed · commit 8f3e2c)</span></div>

        <div class="sh-healer mt-2 rounded-xl bg-cream/[0.04] border border-cream/10 p-3.5">
          <div class="text-[9px] uppercase tracking-wider text-saffron-300 mb-2.5">healer · scanning DOM</div>
          <div class="flex flex-col gap-1.5">
            <div class="sh-sig flex items-center justify-between"><span class="text-onDark-secondary">visual match</span><span class="text-saffron-200 tabular-nums">0.94</span></div>
            <div class="sh-sig flex items-center justify-between"><span class="text-onDark-secondary">semantic match</span><span class="text-saffron-200 tabular-nums">0.91</span></div>
            <div class="sh-sig flex items-center justify-between"><span class="text-onDark-secondary">positional match</span><span class="text-saffron-200 tabular-nums">0.88</span></div>
          </div>
          <div class="sh-candidate mt-2.5 pt-2.5 border-t border-cream/10 text-[#9fdcb4]">→ &lt;button data-testid="submit-order"&gt;</div>
        </div>

        <div class="sh-log-heal text-[#9fdcb4]">✓ 16:41:05 selector healed · run continues</div>
        <div class="sh-log-final mt-auto pt-2 text-onDark-muted">engineer time spent: <span class="text-saffron-300">0 minutes</span></div>
      </div>
    </div>
  </div>
</div>

<script>
  import { withGsap } from '@lib/motion/gsap';
  import { motionTier } from '@lib/motion/tier';

  withGsap(
    (gsap) => {
      const root = document.querySelector<HTMLElement>('.selfheal-scene');
      if (!root) return;
      const q = (s: string) => root.querySelector(s);
      const lineTops = ['0', '1.9em', '3.8em', '5.7em']; // relative to code panel padding

      const pass = q('.sh-pass');
      const counter = { n: 247 };

      const tl = gsap.timeline({
        defaults: { ease: 'power2.out' },
        scrollTrigger:
          motionTier() === 'full'
            ? { trigger: root, start: 'top 80%', end: 'center 40%', scrub: 0.6 }
            : undefined,
        paused: motionTier() !== 'full',
      });
      if (motionTier() !== 'full') {
        const io = new IntersectionObserver(
          (es) => es.some((e) => e.isIntersecting) && (tl.play(), io.disconnect()),
          { threshold: 0.3 }
        );
        io.observe(root);
      }

      const cursor = q('.sh-cursor') as HTMLElement;
      const codePad = 20; // p-5 = 1.25rem

      // Initial states (JS only — no-JS sees the healed final state)
      tl.set(q('.sh-sel-new'), { opacity: 0 }, 0)
        .set(q('.sh-sel-old'), { opacity: 1, textDecoration: 'none' }, 0)
        .set(q('.sh-healed-tag'), { opacity: 0, scale: 0.8 }, 0)
        .set(['.sh-log-fail', '.sh-log-heal', '.sh-log-final'].map(q), { opacity: 0, x: 10 }, 0)
        .set(q('.sh-healer'), { opacity: 0, y: 12 }, 0)
        .set(gsap.utils.toArray('.sh-sig', root), { opacity: 0, x: 8 }, 0)
        .set(q('.sh-candidate'), { opacity: 0 }, 0)
        .set(cursor, { top: codePad, opacity: 1 }, 0)
        .call(() => { if (pass) pass.textContent = '247'; }, [], 0);

      // Beat 1 — run advances through the first two lines
      tl.to(cursor, { top: codePad + 27, duration: 0.3, ease: 'steps(1)' }, 0.15)
        .to(cursor, { top: codePad + 54, duration: 0.3, ease: 'steps(1)' }, 0.5);

      // Beat 2 — the selector breaks
      tl.to(q('.sh-sel-old'), { color: '#f27992', duration: 0.2 }, 0.85)
        .to(q('.sh-log-fail'), { opacity: 1, x: 0, duration: 0.3 }, 0.9)
        .fromTo(q('.sh-line[data-l="3"]'), { backgroundColor: 'rgba(242,121,146,0)' }, { backgroundColor: 'rgba(242,121,146,0.08)', duration: 0.25 }, 0.9);

      // Beat 3 — the healer scans
      tl.to(q('.sh-healer'), { opacity: 1, y: 0, duration: 0.35 }, 1.2)
        .to(gsap.utils.toArray('.sh-sig', root), { opacity: 1, x: 0, stagger: 0.22, duration: 0.25 }, 1.35)
        .to(q('.sh-candidate'), { opacity: 1, duration: 0.3 }, 2.0);

      // Beat 4 — rewrite: old strikes through and fades, new appears
      tl.to(q('.sh-sel-old'), { textDecoration: 'line-through', opacity: 0.35, duration: 0.25 }, 2.3)
        .to(q('.sh-sel-old'), { opacity: 0, duration: 0.3 }, 2.65)
        .to(q('.sh-sel-new'), { opacity: 1, duration: 0.35 }, 2.6)
        .to(q('.sh-line[data-l="3"]'), { backgroundColor: 'rgba(159,220,180,0.07)', duration: 0.3 }, 2.6)
        .to(q('.sh-healed-tag'), { opacity: 1, scale: 1, duration: 0.3, ease: 'back.out(1.6)' }, 2.85)
        .to(q('.sh-log-heal'), { opacity: 1, x: 0, duration: 0.3 }, 2.9);

      // Beat 5 — run continues, counter climbs
      tl.to(cursor, { top: codePad + 81, duration: 0.3, ease: 'steps(1)' }, 3.2)
        .to(counter, {
          n: 252,
          duration: 0.7,
          ease: 'none',
          onUpdate: () => { if (pass) pass.textContent = String(Math.round(counter.n)); },
        }, 3.3)
        .to(q('.sh-line[data-l="3"]'), { backgroundColor: 'rgba(159,220,180,0)', duration: 0.4 }, 3.4)
        .to(q('.sh-log-final'), { opacity: 1, x: 0, duration: 0.3 }, 3.7)
        .to(cursor, { opacity: 0, duration: 0.3 }, 3.9);
    },
    { minTier: 'lite' }
  );
</script>
