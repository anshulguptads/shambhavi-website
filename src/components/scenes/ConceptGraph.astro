---
/**
 * NeuroLink signature scene — a living Concept DNA graph.
 *
 * Server-rendered SVG (the complete graph is the no-JS/static state).
 * Enhancement: edges draw in on reveal, nodes pop by prerequisite depth,
 * signal pulses travel the edges, hovering a concept highlights its
 * neighborhood, nodes are draggable with springy edges, and one weak
 * concept pulses — then the graph traces the gap back to its root cause.
 */

type Status = 'mastered' | 'learning' | 'weak' | 'next';
interface Node {
  id: string;
  label: string;
  x: number;
  y: number;
  r: number;
  status: Status;
  depth: number;
}

const nodes: Node[] = [
  { id: 'you', label: 'You', x: 240, y: 200, r: 38, status: 'mastered', depth: 0 },
  { id: 'python', label: 'Python', x: 90, y: 80, r: 16, status: 'mastered', depth: 1 },
  { id: 'linalg', label: 'Linear Alg.', x: 240, y: 52, r: 16, status: 'mastered', depth: 1 },
  { id: 'calculus', label: 'Calculus', x: 390, y: 80, r: 16, status: 'mastered', depth: 1 },
  { id: 'probability', label: 'Probability', x: 52, y: 200, r: 13, status: 'learning', depth: 2 },
  { id: 'gradients', label: 'Gradients', x: 428, y: 200, r: 13, status: 'learning', depth: 2 },
  { id: 'stats', label: 'Stats', x: 90, y: 320, r: 13, status: 'learning', depth: 2 },
  { id: 'backprop', label: 'Backprop', x: 390, y: 320, r: 14, status: 'weak', depth: 2 },
  { id: 'nn', label: 'Neural Nets', x: 240, y: 352, r: 12, status: 'next', depth: 3 },
  { id: 'cnn', label: 'CNNs', x: 130, y: 396, r: 11, status: 'next', depth: 4 },
  { id: 'transformers', label: 'Transformers', x: 350, y: 396, r: 11, status: 'next', depth: 4 },
];

// [from, to, faint?]
const edges: Array<[string, string, boolean?]> = [
  ['you', 'python'], ['you', 'linalg'], ['you', 'calculus'],
  ['you', 'probability'], ['you', 'gradients'], ['you', 'stats'], ['you', 'backprop'],
  ['linalg', 'gradients', true], ['calculus', 'gradients', true],
  ['gradients', 'backprop', true], ['probability', 'stats', true],
  ['stats', 'nn', true], ['backprop', 'nn', true], ['python', 'nn', true],
  ['nn', 'cnn', true], ['nn', 'transformers', true],
];

const byId = Object.fromEntries(nodes.map((n) => [n.id, n]));

/** Trim a line between two nodes so it meets their circles, not centers. */
function trim(a: Node, b: Node) {
  const dx = b.x - a.x;
  const dy = b.y - a.y;
  const len = Math.hypot(dx, dy) || 1;
  const ux = dx / len;
  const uy = dy / len;
  return {
    x1: +(a.x + ux * (a.r + 2)).toFixed(1),
    y1: +(a.y + uy * (a.r + 2)).toFixed(1),
    x2: +(b.x - ux * (b.r + 2)).toFixed(1),
    y2: +(b.y - uy * (b.r + 2)).toFixed(1),
  };
}

const fill: Record<Status, string> = {
  mastered: '#d99133',
  learning: '#faf7ef',
  weak: '#faf7ef',
  next: 'none',
};
const labelFill: Record<Status, string> = {
  mastered: '#1a1840',
  learning: '#1a1840',
  weak: '#1a1840',
  next: '#faf7ef',
};
---

<div class="concept-graph relative w-full max-w-md mx-auto" role="img" aria-label="A living knowledge graph: mastered concepts like Python and Calculus in saffron, concepts in progress in cream, and locked concepts ahead — with a weak concept, Backprop, traced back to the gap that causes it.">
  <svg viewBox="0 0 480 452" class="w-full h-auto select-none" preserveAspectRatio="xMidYMid meet" aria-hidden="true">
    <defs>
      <radialGradient id="cg-core" cx="0.5" cy="0.5" r="0.5">
        <stop offset="0%" stop-color="#f5b556" />
        <stop offset="60%" stop-color="#d99133" />
        <stop offset="100%" stop-color="#b87627" />
      </radialGradient>
    </defs>

    {/* Edges */}
    <g stroke="#d99133" fill="none" stroke-linecap="round">
      {edges.map(([a, b, faint]) => {
        const t = trim(byId[a], byId[b]);
        return (
          <line
            class="cg-edge"
            data-a={a}
            data-b={b}
            x1={t.x1} y1={t.y1} x2={t.x2} y2={t.y2}
            stroke-width={faint ? 0.8 : 1.2}
            stroke-opacity={faint ? 0.25 : 0.5}
          />
        );
      })}
      {/* traveling signal pulse (endpoints set by script) */}
      <line class="cg-signal" x1="0" y1="0" x2="0" y2="0" stroke="#f5b556" stroke-width="2" stroke-opacity="0" />
      {/* the weak-gap trace overlay */}
      <line class="cg-trace" data-seg="calculus-gradients" x1="0" y1="0" x2="0" y2="0" stroke="#a83254" stroke-width="2.2" stroke-opacity="0" />
      <line class="cg-trace" data-seg="gradients-backprop" x1="0" y1="0" x2="0" y2="0" stroke="#a83254" stroke-width="2.2" stroke-opacity="0" />
    </g>

    {/* Nodes */}
    <g class="cg-nodes">
      {nodes.map((n) => (
        <g
          class:list={['cg-node', `cg-${n.status}`, n.id !== 'you' && 'cg-draggable']}
          data-id={n.id}
          data-x={n.x}
          data-y={n.y}
          data-r={n.r}
          data-depth={n.depth}
          style={`--cx:${n.x}px; --cy:${n.y}px;`}
        >
          {n.id === 'you' ? (
            <>
              <circle cx={n.x} cy={n.y} r={n.r} fill="url(#cg-core)" class="cg-core-pulse" />
              <circle cx={n.x} cy={n.y} r={n.r} fill="none" stroke="#f5b556" stroke-width="1" opacity="0.45" />
              <circle cx={n.x} cy={n.y} r={n.r + 11} fill="none" stroke="#d99133" stroke-width="0.6" opacity="0.3" stroke-dasharray="2 3" class="cg-orbit" />
              <text x={n.x} y={n.y - 2} text-anchor="middle" fill="#1a1840" font-family="Fraunces, serif" font-size="11" font-weight="500" font-style="italic">You</text>
              <text x={n.x} y={n.y + 10} text-anchor="middle" fill="#1a1840" font-family="Manrope, sans-serif" font-size="6" font-weight="600" opacity="0.7">CONCEPT DNA</text>
            </>
          ) : (
            <>
              {n.status === 'weak' && (
                <circle cx={n.x} cy={n.y} r={n.r} fill="none" stroke="#a83254" stroke-width="1.5" class="cg-weak-halo" opacity="0" />
              )}
              <circle
                cx={n.x} cy={n.y} r={n.r}
                fill={fill[n.status]}
                stroke={n.status === 'next' ? '#faf7ef' : n.status === 'weak' ? '#a83254' : 'none'}
                stroke-opacity={n.status === 'next' ? 0.45 : 0.8}
                stroke-width={n.status === 'next' ? 1.2 : 1.4}
              />
              <text
                x={n.x} y={n.y + 2.5}
                text-anchor="middle"
                fill={labelFill[n.status]}
                fill-opacity={n.status === 'next' ? 0.65 : 1}
                font-family="Manrope, sans-serif"
                font-size={Math.min(7.5, (n.r * 2 - 4) / (n.label.length * 0.62))}
                font-weight="600"
              >{n.label}</text>
            </>
          )}
        </g>
      ))}
    </g>

    {/* Gap-trace chip */}
    <g class="cg-gap-chip" opacity="0" transform="translate(310, 258)">
      <rect x="0" y="0" rx="6" width="152" height="22" fill="#a83254" fill-opacity="0.14" stroke="#a83254" stroke-opacity="0.5" stroke-width="0.6"/>
      <text x="76" y="14.5" text-anchor="middle" fill="#faf7ef" font-family="Manrope, sans-serif" font-size="8.5" font-weight="600" letter-spacing="0.4">gap traced → Calculus</text>
    </g>

    {/* Legend */}
    <g font-family="Manrope, sans-serif" font-size="7" letter-spacing="1.5">
      <g transform="translate(20, 442)">
        <circle cx="5" cy="0" r="3" fill="#d99133" />
        <text x="13" y="2.5" fill="#faf7ef" fill-opacity="0.75">MASTERED</text>
      </g>
      <g transform="translate(105, 442)">
        <circle cx="5" cy="0" r="3" fill="#faf7ef" />
        <text x="13" y="2.5" fill="#faf7ef" fill-opacity="0.75">LEARNING</text>
      </g>
      <g transform="translate(190, 442)">
        <circle cx="5" cy="0" r="3" fill="none" stroke="#faf7ef" stroke-opacity="0.5" />
        <text x="13" y="2.5" fill="#faf7ef" fill-opacity="0.75">NEXT</text>
      </g>
      <text x="460" y="444.5" fill="#faf7ef" fill-opacity="0.4" text-anchor="end">CONCEPT DNA · LIVE</text>
    </g>
  </svg>

  <p class="cg-hint hidden [@media(pointer:fine)]:block absolute -bottom-6 left-1/2 -translate-x-1/2 whitespace-nowrap text-[10px] uppercase tracking-eyebrow text-onDark-muted opacity-0 transition-opacity duration-700" aria-hidden="true">
    drag a concept · hover to explore
  </p>
</div>

<style>
  .cg-node { transform-box: fill-box; cursor: default; }
  .cg-draggable { cursor: grab; }
  .cg-draggable:active { cursor: grabbing; }
  .cg-node, .cg-edge { transition: opacity 350ms ease; }
  .concept-graph.cg-focus .cg-node:not(.cg-lit),
  .concept-graph.cg-focus .cg-edge:not(.cg-lit) { opacity: 0.18; }
  @media (prefers-reduced-motion: reduce) {
    .cg-node, .cg-edge { transition: none; }
  }
</style>

<script>
  import { withGsap } from '@lib/motion/gsap';

  withGsap(
    (gsap) => {
      const root = document.querySelector<HTMLElement>('.concept-graph');
      if (!root) return;
      const svg = root.querySelector('svg')!;
      const nodeEls = Array.from(root.querySelectorAll<SVGGElement>('.cg-node'));
      const edgeEls = Array.from(root.querySelectorAll<SVGLineElement>('.cg-edge'));

      interface N { el: SVGGElement; x: number; y: number; r: number; ox: number; oy: number; }
      const N: Record<string, N> = {};
      nodeEls.forEach((el) => {
        N[el.dataset.id!] = { el, x: +el.dataset.x!, y: +el.dataset.y!, r: +el.dataset.r!, ox: 0, oy: 0 };
      });

      const edgeFor = (a: string, b: string) =>
        edgeEls.find((e) => (e.dataset.a === a && e.dataset.b === b) || (e.dataset.a === b && e.dataset.b === a));

      function layoutEdge(line: SVGLineElement) {
        const a = N[line.dataset.a!];
        const b = N[line.dataset.b!];
        const ax = a.x + a.ox, ay = a.y + a.oy, bx = b.x + b.ox, by = b.y + b.oy;
        const dx = bx - ax, dy = by - ay;
        const len = Math.hypot(dx, dy) || 1;
        const ux = dx / len, uy = dy / len;
        line.setAttribute('x1', String(ax + ux * (a.r + 2)));
        line.setAttribute('y1', String(ay + uy * (a.r + 2)));
        line.setAttribute('x2', String(bx - ux * (b.r + 2)));
        line.setAttribute('y2', String(by - uy * (b.r + 2)));
      }
      const edgesOf = (id: string) => edgeEls.filter((e) => e.dataset.a === id || e.dataset.b === id);
      const neighborsOf = (id: string) => new Set(edgesOf(id).flatMap((e) => [e.dataset.a!, e.dataset.b!]));

      // ---- Build-in on reveal ----
      edgeEls.forEach((e) => {
        const len = Math.hypot(+e.getAttribute('x2')! - +e.getAttribute('x1')!, +e.getAttribute('y2')! - +e.getAttribute('y1')!);
        e.style.strokeDasharray = String(len);
        e.style.strokeDashoffset = String(len);
      });
      // Paused timeline played by IntersectionObserver — reliable even when
      // the scene is already in view at creation (hero placement).
      const build = gsap.timeline({ paused: true, defaults: { ease: 'power2.out' } });
      const io = new IntersectionObserver(
        (entries) => {
          if (entries.some((en) => en.isIntersecting)) {
            build.play();
            io.disconnect();
          }
        },
        { threshold: 0.2 }
      );
      io.observe(root);
      build
        .from(N.you.el, { scale: 0, transformOrigin: '50% 50%', duration: 0.6 }, 0)
        .to(edgeEls, { strokeDashoffset: 0, duration: 0.7, stagger: 0.045 }, 0.15)
        .from(
          nodeEls.filter((el) => el.dataset.id !== 'you'),
          { scale: 0, transformOrigin: '50% 50%', duration: 0.5, stagger: { each: 0.07, from: 'start' } },
          0.35
        )
        .to(root.querySelector('.cg-hint'), { opacity: 1, duration: 0.5 }, 1.4);

      // ---- Weak-gap trace: Backprop ← Gradients ← Calculus ----
      const traceSegs = [
        { line: root.querySelector<SVGLineElement>('[data-seg="calculus-gradients"]')!, a: 'calculus', b: 'gradients' },
        { line: root.querySelector<SVGLineElement>('[data-seg="gradients-backprop"]')!, a: 'gradients', b: 'backprop' },
      ];
      const layoutTraces = () =>
        traceSegs.forEach(({ line, a, b }) => {
          const src = edgeFor(a, b);
          if (!src) return;
          ['x1', 'y1', 'x2', 'y2'].forEach((k) => line.setAttribute(k, src.getAttribute(k)!));
        });
      layoutTraces();

      const weakHalo = root.querySelector('.cg-weak-halo');
      const chip = root.querySelector('.cg-gap-chip');
      build.add(() => {
        // pulse the weak node forever
        gsap.to(weakHalo, {
          opacity: 0.8,
          scale: 1.45,
          transformOrigin: '50% 50%',
          duration: 1.4,
          repeat: -1,
          yoyo: false,
          ease: 'power1.out',
          onRepeat: () => gsap.set(weakHalo, { opacity: 0, scale: 1 }),
        });
        // trace the gap once
        const tr = gsap.timeline({ delay: 0.7 });
        traceSegs.forEach(({ line }, i) => {
          const len = Math.hypot(+line.getAttribute('x2')! - +line.getAttribute('x1')!, +line.getAttribute('y2')! - +line.getAttribute('y1')!);
          gsap.set(line, { strokeDasharray: len, strokeDashoffset: len });
          tr.to(line, { strokeOpacity: 0.9, strokeDashoffset: 0, duration: 0.55, ease: 'power1.inOut' }, i * 0.5);
        });
        tr.to(chip, { opacity: 1, duration: 0.4 }, 0.9)
          .to([chip, ...traceSegs.map((s) => s.line)], { opacity: 0, strokeOpacity: 0, duration: 0.8 }, '+=2.4');
      }, 1.15);

      // ---- Idle: core pulse + signals traveling random edges ----
      gsap.to(root.querySelector('.cg-core-pulse'), { opacity: 0.85, duration: 1.6, repeat: -1, yoyo: true, ease: 'sine.inOut' });
      gsap.to(root.querySelector('.cg-orbit'), { rotation: 360, transformOrigin: '50% 50%', duration: 60, repeat: -1, ease: 'none' });
      const signal = root.querySelector<SVGLineElement>('.cg-signal')!;
      const sendSignal = () => {
        const e = edgeEls[Math.floor(Math.random() * edgeEls.length)];
        ['x1', 'y1', 'x2', 'y2'].forEach((k) => signal.setAttribute(k, e.getAttribute(k)!));
        const len = Math.hypot(+e.getAttribute('x2')! - +e.getAttribute('x1')!, +e.getAttribute('y2')! - +e.getAttribute('y1')!);
        gsap.fromTo(
          signal,
          { strokeDasharray: `${len * 0.3} ${len * 1.3}`, strokeDashoffset: len * 1.3, strokeOpacity: 0.9 },
          { strokeDashoffset: -len * 0.35, strokeOpacity: 0, duration: 1.3, ease: 'power1.in' }
        );
      };
      const signalLoop = window.setInterval(sendSignal, 2200);

      // ---- Hover neighborhoods ----
      const enter = (id: string) => {
        const hood = neighborsOf(id);
        hood.add(id);
        nodeEls.forEach((el) => el.classList.toggle('cg-lit', hood.has(el.dataset.id!)));
        edgeEls.forEach((el) => el.classList.toggle('cg-lit', el.dataset.a === id || el.dataset.b === id));
        root.classList.add('cg-focus');
      };
      const leave = () => {
        root.classList.remove('cg-focus');
        nodeEls.forEach((el) => el.classList.remove('cg-lit'));
        edgeEls.forEach((el) => el.classList.remove('cg-lit'));
      };
      nodeEls.forEach((el) => {
        el.addEventListener('pointerenter', () => enter(el.dataset.id!));
        el.addEventListener('pointerleave', leave);
      });

      // ---- Drag with springy return ----
      let drag: { n: N; startX: number; startY: number; scale: number } | null = null;
      const applyNode = (n: N) => {
        gsap.set(n.el, { x: n.ox, y: n.oy });
        edgesOf(n.el.dataset.id!).forEach(layoutEdge);
        layoutTraces();
      };
      const down = (e: PointerEvent) => {
        const g = (e.target as Element).closest('.cg-draggable') as SVGGElement | null;
        if (!g) return;
        const n = N[g.dataset.id!];
        gsap.killTweensOf(n);
        const rect = svg.getBoundingClientRect();
        drag = { n, startX: e.clientX, startY: e.clientY, scale: 480 / rect.width };
        svg.setPointerCapture(e.pointerId);
        e.preventDefault();
      };
      const move = (e: PointerEvent) => {
        if (!drag) return;
        const { n, startX, startY, scale } = drag;
        n.ox = gsap.utils.clamp(-70, 70, (e.clientX - startX) * scale);
        n.oy = gsap.utils.clamp(-70, 70, (e.clientY - startY) * scale);
        applyNode(n);
      };
      const up = () => {
        if (!drag) return;
        const { n } = drag;
        drag = null;
        gsap.to(n, {
          ox: 0,
          oy: 0,
          duration: 1.15,
          ease: 'elastic.out(1, 0.42)',
          onUpdate: () => applyNode(n),
        });
      };
      svg.addEventListener('pointerdown', down);
      svg.addEventListener('pointermove', move);
      svg.addEventListener('pointerup', up);
      svg.addEventListener('pointercancel', up);

      return () => {
        io.disconnect();
        window.clearInterval(signalLoop);
        svg.removeEventListener('pointerdown', down);
        svg.removeEventListener('pointermove', move);
        svg.removeEventListener('pointerup', up);
        svg.removeEventListener('pointercancel', up);
      };
    },
    { minTier: 'lite' }
  );
</script>
