---
/**
 * Form behavior shell: honeypot, optional Turnstile, error banner,
 * progressive enhancement (fetch submit with inline field errors + success
 * panel), and a plain-POST fallback that works with JavaScript disabled.
 */
import Button from '@components/ui/Button.astro';

interface Props {
  action: string;
  submitLabel: string;
  successTitle: string;
  successBody: string;
}
const { action, submitLabel, successTitle, successBody } = Astro.props;
const turnstileSiteKey = import.meta.env.PUBLIC_TURNSTILE_SITE_KEY as string | undefined;
---

<form method="POST" action={action} class="lead-form flex flex-col gap-6" novalidate>
  {/* Server-message banner (no-JS ?error= flow + fetch-level failures) */}
  <div class="lf-banner hidden rounded-xl border border-[#f27992]/40 bg-[#f27992]/10 px-4 py-3 text-sm text-[#ffd9e1]" role="alert"></div>

  <slot />

  {/* Honeypot — humans never see this */}
  <div class="absolute -left-[9999px] top-auto h-px w-px overflow-hidden" aria-hidden="true">
    <label>Leave this field empty <input type="text" name="website" tabindex="-1" autocomplete="off" /></label>
  </div>

  {turnstileSiteKey && (
    <>
      <div class="cf-turnstile" data-sitekey={turnstileSiteKey} data-size="flexible" data-theme="dark"></div>
      <script is:inline src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>
    </>
  )}

  <div class="flex flex-col sm:flex-row items-start sm:items-center gap-4 pt-2">
    <Button type="submit" variant="primary" size="lg" class="lf-submit min-w-[13rem] justify-center">
      {submitLabel}
    </Button>
    <p class="text-xs text-onDark-muted">
      or email <a href="mailto:info@shambhavilabs.com" class="text-saffron-300 hover:text-saffron-200 underline underline-offset-2">info@shambhavilabs.com</a>
    </p>
  </div>
</form>

{/* Inline success panel (fetch path; no-JS lands on /thanks) */}
<div class="lf-success hidden rounded-2xl border border-saffron-400/30 bg-saffron-400/[0.07] p-8 md:p-10 text-center">
  <div class="mx-auto mb-5 flex h-12 w-12 items-center justify-center rounded-full bg-saffron-400 text-navy" aria-hidden="true">
    <svg width="20" height="20" viewBox="0 0 20 20" fill="none"><path d="M4 10.5l4 4 8-9" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
  </div>
  <h2 class="font-serif fraunces-display text-2xl md:text-3xl text-onDark-primary">{successTitle}</h2>
  <p class="mt-3 text-onDark-secondary text-sm md:text-base max-w-md mx-auto text-pretty">{successBody}</p>
</div>

<script>
  import { onPageReady } from '@lib/motion/lifecycle';

  onPageReady(() => {
    const forms = Array.from(document.querySelectorAll<HTMLFormElement>('form.lead-form'));
    if (forms.length === 0) return;

    const cleanups: Array<() => void> = [];

    // Surface no-JS errors carried back via ?error=
    const errParam = new URLSearchParams(location.search).get('error');

    for (const form of forms) {
      const banner = form.querySelector<HTMLElement>('.lf-banner');
      const success = form.parentElement?.querySelector<HTMLElement>('.lf-success');
      const submitBtn = form.querySelector<HTMLButtonElement>('.lf-submit');
      const fieldErrs = () => Array.from(form.querySelectorAll<HTMLElement>('.lf-err'));

      if (errParam && banner) {
        banner.textContent = errParam;
        banner.classList.remove('hidden');
      }

      const clearErrors = () => {
        banner?.classList.add('hidden');
        fieldErrs().forEach((el) => {
          el.hidden = true;
          el.textContent = '';
        });
      };

      const showFieldErrors = (errors: Record<string, string>) => {
        let firstShown: HTMLElement | null = null;
        for (const [field, msg] of Object.entries(errors)) {
          const el = form.querySelector<HTMLElement>(`.lf-err[data-for="${field}"]`);
          if (el) {
            el.textContent = friendly(field, msg);
            el.hidden = false;
            firstShown ??= el;
          } else if (banner) {
            banner.textContent = friendly(field, msg);
            banner.classList.remove('hidden');
          }
        }
        firstShown?.closest('div, fieldset')?.scrollIntoView({ block: 'center', behavior: 'smooth' });
      };

      const friendly = (field: string, msg: string) => {
        if (/email/i.test(field) && /invalid/i.test(msg)) return 'Please enter a valid email address.';
        if (/too small|>=1|expected string/i.test(msg)) return 'This field is required.';
        if (field === 'platforms') return 'Pick at least one platform.';
        return msg;
      };

      let pending = false;
      const onSubmit = async (e: SubmitEvent) => {
        e.preventDefault();
        if (pending) return;
        pending = true;
        clearErrors();
        const original = submitBtn?.textContent ?? '';
        if (submitBtn) {
          submitBtn.disabled = true;
          submitBtn.textContent = 'Sending…';
        }
        try {
          const res = await fetch(form.action, {
            method: 'POST',
            body: new FormData(form),
            headers: { Accept: 'application/json' },
          });
          const body = (await res.json().catch(() => ({}))) as {
            ok?: boolean;
            errors?: Record<string, string>;
            message?: string;
          };
          if (res.ok && body.ok) {
            form.classList.add('hidden');
            success?.classList.remove('hidden');
            success?.scrollIntoView({ block: 'center', behavior: 'smooth' });
          } else if (body.errors) {
            showFieldErrors(body.errors);
          } else if (banner) {
            banner.textContent = body.message ?? 'Something went wrong — please try again, or email info@shambhavilabs.com.';
            banner.classList.remove('hidden');
          }
        } catch {
          if (banner) {
            banner.textContent = 'Network hiccup — please try again, or email info@shambhavilabs.com.';
            banner.classList.remove('hidden');
          }
        } finally {
          pending = false;
          if (submitBtn) {
            submitBtn.disabled = false;
            submitBtn.textContent = original;
          }
        }
      };

      form.addEventListener('submit', onSubmit);
      cleanups.push(() => form.removeEventListener('submit', onSubmit));
    }

    return () => cleanups.forEach((fn) => fn());
  });
</script>
