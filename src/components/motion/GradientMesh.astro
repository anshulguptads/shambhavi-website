---
/**
 * Ambient drifting gradient mesh — a slow, living upgrade over the static
 * GradientOrb glow on dark sections. Canvas renders at 1/6 resolution with
 * additive blobs; pauses offscreen and when the tab is hidden. Full tier
 * only; everyone else keeps the CSS orbs (which remain underneath anyway).
 */
interface Props {
  class?: string;
  variant?: 'hero' | 'cta';
}
const { class: className = '', variant = 'hero' } = Astro.props;
---

<canvas
  aria-hidden="true"
  data-mesh={variant}
  class:list={['absolute inset-0 w-full h-full pointer-events-none opacity-0 transition-opacity duration-[1400ms]', className]}></canvas>

<script>
  import { onPageReady } from '@lib/motion/lifecycle';
  import { motionTier } from '@lib/motion/tier';

  interface Blob { hue: [number, number, number]; alpha: number; r: number; sx: number; sy: number; px: number; py: number; }

  const PALETTES: Record<string, Blob[]> = {
    hero: [
      { hue: [217, 145, 51], alpha: 0.16, r: 0.55, sx: 0.21, sy: 0.13, px: 0.72, py: 0.18 },
      { hue: [168, 50, 84], alpha: 0.12, r: 0.48, sx: 0.15, sy: 0.19, px: 0.12, py: 0.78 },
      { hue: [245, 181, 86], alpha: 0.08, r: 0.4, sx: 0.11, sy: 0.09, px: 0.5, py: 0.5 },
    ],
    cta: [
      { hue: [217, 145, 51], alpha: 0.15, r: 0.5, sx: 0.17, sy: 0.12, px: 0.5, py: 0.1 },
      { hue: [168, 50, 84], alpha: 0.1, r: 0.45, sx: 0.13, sy: 0.16, px: 0.3, py: 0.55 },
    ],
  };

  onPageReady(() => {
    if (motionTier() !== 'full') return;
    const canvases = Array.from(document.querySelectorAll<HTMLCanvasElement>('canvas[data-mesh]'));
    if (canvases.length === 0) return;

    const cleanups: Array<() => void> = [];

    for (const canvas of canvases) {
      const blobs = PALETTES[canvas.dataset.mesh ?? 'hero'] ?? PALETTES.hero;
      const ctx = canvas.getContext('2d');
      if (!ctx) continue;

      let running = false;
      let rafId = 0;
      let last = 0;
      const t0 = performance.now();

      const resize = () => {
        const r = canvas.getBoundingClientRect();
        canvas.width = Math.max(2, Math.round(r.width / 6));
        canvas.height = Math.max(2, Math.round(r.height / 6));
      };
      resize();
      window.addEventListener('resize', resize);

      const frame = (now: number) => {
        if (!running) return;
        rafId = requestAnimationFrame(frame);
        if (now - last < 33) return; // ~30fps is plenty for ambience
        last = now;
        const t = (now - t0) / 1000;
        const { width: w, height: h } = canvas;
        ctx.clearRect(0, 0, w, h);
        ctx.globalCompositeOperation = 'lighter';
        for (let i = 0; i < blobs.length; i++) {
          const b = blobs[i];
          const x = (b.px + Math.sin(t * b.sx + i * 2.1) * 0.16) * w;
          const y = (b.py + Math.cos(t * b.sy + i * 1.4) * 0.14) * h;
          const rad = b.r * Math.max(w, h) * (1 + Math.sin(t * 0.07 + i) * 0.08);
          const g = ctx.createRadialGradient(x, y, 0, x, y, rad);
          g.addColorStop(0, `rgba(${b.hue[0]},${b.hue[1]},${b.hue[2]},${b.alpha})`);
          g.addColorStop(1, 'rgba(0,0,0,0)');
          ctx.fillStyle = g;
          ctx.fillRect(0, 0, w, h);
        }
      };

      const start = () => {
        if (running) return;
        running = true;
        canvas.classList.remove('opacity-0');
        rafId = requestAnimationFrame(frame);
      };
      const stop = () => {
        running = false;
        cancelAnimationFrame(rafId);
      };

      const io = new IntersectionObserver((es) => {
        es.forEach((e) => (e.isIntersecting && !document.hidden ? start() : stop()));
      });
      io.observe(canvas);
      const onVis = () => (document.hidden ? stop() : io.takeRecords().length, undefined);
      document.addEventListener('visibilitychange', onVis);

      cleanups.push(() => {
        stop();
        io.disconnect();
        window.removeEventListener('resize', resize);
        document.removeEventListener('visibilitychange', onVis);
      });
    }

    return () => cleanups.forEach((fn) => fn());
  });
</script>
