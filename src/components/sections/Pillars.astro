---
import Eyebrow from '@components/ui/Eyebrow.astro';
import Reveal from '@components/motion/Reveal.astro';

const pillars = [
  {
    num: '01',
    label: 'Learn',
    title: 'Learn.',
    desc: 'AI-native learning for every stage — from a student in a village school discovering their first dream, to a university engineer training on tomorrow\'s models.',
    products: ['AspiremsAI', 'NeuroLink'],
  },
  {
    num: '02',
    label: 'Work',
    title: 'Work.',
    desc: 'The workplace rebuilt with intelligence at its core — payroll, performance, people, and compliance across countries, languages, and regulations.',
    products: ['SanaDeep'],
  },
  {
    num: '03',
    label: 'Build',
    title: 'Build.',
    desc: 'AI for the people who build the software that runs the world — test generation, self-healing automation, and analytics validation at engineering scale.',
    products: ['InsightTest AI'],
  },
];
---

<section class="section-pad bg-cream text-ink-primary relative grain-overlay" id="pillars" aria-labelledby="pillars-heading">
  {/* Progress rail — only visible while the pinned story plays (GSAP-controlled) */}
  <div
    aria-hidden="true"
    class="pillars-rail hidden lg:flex opacity-0 absolute left-5 xl:left-8 top-1/2 -translate-y-1/2 flex-col items-center gap-0 z-10 pointer-events-none"
  >
    <div class="relative w-px h-40 bg-navy/10 overflow-hidden rounded-full">
      <div class="pillars-rail-fill absolute inset-x-0 top-0 h-full bg-gradient-to-b from-saffron-400 to-saffron-500 origin-top scale-y-0"></div>
    </div>
    <div class="absolute inset-y-0 -left-[3.5px] flex flex-col justify-between py-0">
      {pillars.map(() => (
        <span class="pillars-rail-dot w-2 h-2 rounded-full bg-navy/15 transition-colors duration-300"></span>
      ))}
    </div>
  </div>

  <div class="container-page">
    <div class="max-w-3xl">
      <Reveal>
        <Eyebrow withLine={true}>Three Pillars</Eyebrow>
      </Reveal>
      <Reveal delay={100}>
        <h2 id="pillars-heading" class="mt-6 font-serif fraunces-display text-display-lg text-navy text-balance">
          One thesis. <em class="italic font-light text-saffron-500">Three stages of human potential.</em> Four products that turn it real.
        </h2>
      </Reveal>
    </div>

    <div class="mt-16 md:mt-20 grid md:grid-cols-3 gap-6 md:gap-8">
      {pillars.map((pillar) => (
        <article data-tilt class="pillar-card group relative h-full rounded-3xl bg-cream-50 border border-navy/8 p-8 md:p-9 flex flex-col transition-[border-color,box-shadow] duration-500 ease-out-expo hover:border-saffron-400/40 hover:shadow-lift">
          <div class="flex items-baseline gap-3 text-xs font-mono text-ink-muted mb-6">
            <span class="pillar-num text-saffron-500 font-semibold">{pillar.num}</span>
            <span class="h-px flex-1 bg-navy/10"></span>
            <span class="uppercase tracking-eyebrow">{pillar.label}</span>
          </div>

          <h3 class="font-serif fraunces-display text-display-md text-navy italic font-light">
            {pillar.title}
          </h3>

          <p class="mt-5 text-base leading-relaxed text-ink-secondary text-pretty">
            {pillar.desc}
          </p>

          <div class="mt-auto pt-8">
            <p class="eyebrow text-ink-faint mb-3">{pillar.products.length === 1 ? 'Product' : 'Products'}</p>
            <ul class="space-y-2">
              {pillar.products.map((product) => (
                <li class="pillar-prod flex items-center gap-2 text-sm font-medium text-navy">
                  <span class="w-1 h-1 rounded-full bg-saffron-400"></span>
                  {product}
                </li>
              ))}
            </ul>
          </div>

          {/* Accent line — drawn by the story, completed on hover */}
          <span aria-hidden="true" class="pillar-accent absolute left-8 right-8 bottom-0 h-[2px] bg-gradient-signature origin-left scale-x-0 group-hover:scale-x-100 transition-transform duration-500 ease-out-expo"></span>
        </article>
      ))}
    </div>
  </div>
</section>

<script>
  import { withGsap } from '@lib/motion/gsap';

  // Pinned scroll-story: Learn → Work → Build assemble in sequence.
  // Runs only on 'full'-tier devices at lg+ widths; everywhere else the
  // cards are simply visible (the markup's natural state).
  withGsap((gsap) => {
    const section = document.getElementById('pillars');
    if (!section) return;

    const mm = gsap.matchMedia();
    mm.add('(min-width: 1024px)', () => {
      const cards = gsap.utils.toArray<HTMLElement>('.pillar-card', section);
      const rail = section.querySelector('.pillars-rail');
      const railFill = section.querySelector('.pillars-rail-fill');
      const dots = gsap.utils.toArray<HTMLElement>('.pillars-rail-dot', section);
      if (cards.length !== 3) return;

      gsap.set(cards, { opacity: 0.14, y: 64, scale: 0.96 });

      const tl = gsap.timeline({
        defaults: { ease: 'power2.out' },
        scrollTrigger: {
          trigger: section,
          start: 'top top',
          end: () => '+=' + Math.round(window.innerHeight * 2.1),
          pin: true,
          scrub: 0.75,
          anticipatePin: 1,
        },
      });

      tl.to(rail, { opacity: 1, duration: 0.25 }, 0);

      cards.forEach((card, i) => {
        const at = i * 1.0;
        tl.to(card, { opacity: 1, y: 0, scale: 1, duration: 0.85 }, at)
          .from(
            card.querySelectorAll('.pillar-prod'),
            { x: -16, opacity: 0, stagger: 0.12, duration: 0.4 },
            at + 0.3
          )
          .fromTo(
            card.querySelector('.pillar-accent'),
            { scaleX: 0 },
            { scaleX: 1, duration: 0.5, ease: 'power1.inOut' },
            at + 0.35
          )
          .to(
            railFill,
            { scaleY: (i + 1) / 3, duration: 0.85, ease: 'none' },
            at
          )
          .add(() => {
            dots.forEach((d, di) =>
              d.classList.toggle('bg-saffron-500', di <= i && tl.progress() > (i + 0.2) / 3.4)
            );
          }, at + 0.2);
      });

      // brief hold at the end, then the rail bows out
      tl.to(rail, { opacity: 0, duration: 0.3 }, '+=0.4');
    });

    return () => mm.revert();
  });
</script>
