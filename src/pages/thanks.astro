---
import PageLayout from '@layouts/PageLayout.astro';
import Button from '@components/ui/Button.astro';
import GradientOrb from '@components/motion/GradientOrb.astro';
---

<PageLayout
  title="Thank you"
  description="Your message is on its way — a founder will reply within one business day."
  canonical="/thanks"
  noindex={true}
  headerMode="over-dark"
>
  <section class="relative overflow-hidden bg-navy-deepest text-onDark-primary grain-overlay min-h-svh flex items-center pt-28 pb-20">
    <GradientOrb class="-top-32 left-1/2 -translate-x-1/2" color="saffron" size="lg" />

    <div class="container-page relative max-w-2xl text-center">
      <div class="mx-auto mb-8 flex h-14 w-14 items-center justify-center rounded-full bg-saffron-400 text-navy animate-fade-in" aria-hidden="true">
        <svg width="24" height="24" viewBox="0 0 20 20" fill="none"><path d="M4 10.5l4 4 8-9" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
      </div>
      <h1 class="font-serif fraunces-display text-display-lg text-onDark-primary text-balance leading-[1] animate-fade-up">
        Got it. <em class="italic font-light text-saffron-300">Thank you.</em>
      </h1>
      <p class="mt-7 text-lead text-onDark-secondary text-pretty animate-fade-up" style="animation-delay: 120ms">
        A founder reads every message — you'll hear back within one business day. If it's urgent, email
        <a href="mailto:info@shambhavilabs.com" class="text-saffron-300 hover:text-saffron-200 underline underline-offset-2">info@shambhavilabs.com</a>.
      </p>
      <div class="mt-10 flex flex-col sm:flex-row gap-3 sm:gap-4 justify-center animate-fade-up" style="animation-delay: 240ms">
        <Button href="/" variant="primary" size="lg">Back to home</Button>
        <Button href="/journal" variant="ghost-dark" size="lg" icon="none">Read the journal</Button>
      </div>
    </div>
  </section>
</PageLayout>
