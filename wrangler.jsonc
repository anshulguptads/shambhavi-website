{
  // Cloudflare Workers Builds reads this at deploy time. The dashboard's
  // stored deploy command supplies the assets directory, so this file only
  // pins identity + runtime flags — adding `main`/`assets` here conflicts
  // with that command's flags and fails the deploy.
  //
  // To activate the SERVER side (form APIs, Keystatic) change the Workers
  // Builds deploy command to:  npx wrangler deploy --config wrangler.worker.jsonc
  // (docs/DYNAMIC-SETUP.md step 0).
  "$schema": "https://unpkg.com/wrangler/config-schema.json",
  "name": "shambhavi-website",
  "compatibility_date": "2026-07-01",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true
  }
}
