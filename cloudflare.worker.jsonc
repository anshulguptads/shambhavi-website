{
  // FULL worker config — static assets + the Astro server (form APIs,
  // Keystatic). Used when the Workers Builds deploy command is:
  //   npx wrangler deploy --config cloudflare.worker.jsonc
  // (docs/DYNAMIC-SETUP.md step 0.)
  //
  // After `wrangler d1 create shambhavi-forms`, uncomment and paste the id:
  // "d1_databases": [
  //   { "binding": "DB", "database_name": "shambhavi-forms", "database_id": "<from wrangler d1 create>" }
  // ],
  "$schema": "https://unpkg.com/wrangler/config-schema.json",
  "name": "shambhavi-website",
  "compatibility_date": "2026-07-01",
  "compatibility_flags": ["nodejs_compat"],
  "main": "dist/_worker.js/index.js",
  "assets": {
    "binding": "ASSETS",
    "directory": "./dist"
  },
  "observability": {
    "enabled": true
  }
}
